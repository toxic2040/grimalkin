# Grimalkin configuration — all variables are optional.
# Copy to .env and edit as needed. Prefix: GRIM_

GRIM_HOST=127.0.0.1
GRIM_PORT=7860
GRIM_OLLAMA_MODEL=gemma4:12b-it-qat
GRIM_OLLAMA_URL=http://localhost:11434
GRIM_EMBED_MODEL=nomic-embed-text
GRIM_EMBED_DIM=768
GRIM_CHUNK_SIZE=800
GRIM_CHUNK_OVERLAP=100
GRIM_CONTEXT_BUDGET=4000
GRIM_AUTH_TOKEN=
# PII redaction defaults to deterministic local redaction before LLM/retrieval.
# Set GRIM_PII_REVEAL=true only when local output rehydration is desired.
# GRIM_PII_REDACTION=deterministic   # deterministic|hybrid|off
# GRIM_PII_KEEP=CITY,STATE,ZIP_CODE
# GRIM_PII_REVEAL=false
# GRIM_GLINER_PII_MODEL=/path/to/local/gliner-model
# GRIM_ALLOW_MODEL_DOWNLOADS=false
# Optional local voice adapters.
# Grimalkin shells out to scripts/grim_voice.py for speech in and out. The
# adapter detects engines by looking for their command-line program on PATH,
# not by importing anything, so an engine only counts as installed once its CLI
# is reachable. ~/.local/bin is on PATH on most setups and is a good place to
# symlink a CLI that lives in a virtualenv. See what is visible with:
#   python scripts/grim_voice.py status
# GRIM_STT_COMMAND={python} {app}/scripts/grim_voice.py stt --audio {audio} --out {out}
# GRIM_TTS_COMMAND={python} {app}/scripts/grim_voice.py tts --text-file {text_file} --out {out}
# GRIM_KEEP_VOICE_AUDIO=false
#
# Speech-to-text engines, tried in this order when GRIM_STT_ENGINE=auto:
#   1. whisper-ctranslate2 (the faster-whisper CLI) — recommended. Whisper-grade
#      accuracy, no PyTorch, and it decodes audio itself so no system ffmpeg is
#      needed.
#        pip install whisper-ctranslate2
#        ln -s "$VENV/bin/whisper-ctranslate2" ~/.local/bin/
#   2. whisper (the reference whisper CLI), used if it is already on PATH; it
#      needs ffmpeg installed separately.
#   3. vosk-transcriber — lightweight fallback, auto-downloads a small model:
#        pip install vosk
#        ln -s "$VENV/bin/vosk-transcriber" ~/.local/bin/
# Force one engine instead of auto with GRIM_STT_ENGINE; it accepts a CLI name
# or a friendly alias (faster-whisper, whisper-ctranslate2, whisper,
# vosk-transcriber, vosk). Whisper models auto-download on first use and are
# cached under ~/.cache.
# GRIM_STT_ENGINE=auto
# GRIM_FASTER_WHISPER_MODEL=small   # tiny|base|small|medium|large-v3
# GRIM_FASTER_WHISPER_COMPUTE=int8  # int8 is fast on CPU; or float16/float32
# GRIM_WHISPER_MODEL=base           # model for the reference whisper CLI
# GRIM_STT_LANGUAGE=                # e.g. en; empty means autodetect
#
# Text-to-speech engines, tried in order when GRIM_TTS_ENGINE=auto:
# Piper, espeak-ng, espeak, pico2wave, flite, then spd-say.
# GRIM_TTS_ENGINE=auto
# GRIM_PIPER_MODEL=/path/to/piper-voice.onnx
# GRIM_HUNTING_GROUNDS=/path/to/watch
# GRIM_SANDBOX=true
# Ingestion guards — files are parsed in an isolated worker with these caps.
# GRIM_MAX_INGEST_MB=25      # reject larger files before parsing
# GRIM_PARSE_TIMEOUT=60      # wall-clock seconds per file
# GRIM_PARSE_MEM_MB=1024     # address-space cap for the parse worker
