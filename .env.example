# Grimalkin configuration — all variables are optional.
# Copy to .env and edit as needed. Prefix: GRIM_

GRIM_HOST=127.0.0.1
GRIM_PORT=7860
GRIM_OLLAMA_MODEL=local-chat-model
GRIM_OLLAMA_URL=http://localhost:11434
GRIM_EMBED_MODEL=local-embedding-model
GRIM_EMBED_DIM=768
GRIM_CHUNK_SIZE=800
GRIM_CHUNK_OVERLAP=100
GRIM_CONTEXT_BUDGET=4000
GRIM_AUTH_TOKEN=
# Optional local voice adapters.
# STT command receives {audio}; it may write transcript text to {out} or stdout.
# TTS command receives response text on stdin unless {text} or {text_file} is used;
# it should write playable audio to {out}.
# GRIM_STT_COMMAND=whisper-cli {audio} --output-txt {out}
# GRIM_TTS_COMMAND=piper --model /path/to/voice.onnx --output_file {out}
# GRIM_KEEP_VOICE_AUDIO=false
# GRIM_HUNTING_GROUNDS=/path/to/watch
# GRIM_SANDBOX=true
